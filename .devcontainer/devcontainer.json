{
  "name": "MineLink Agent Worktree",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "remoteUser": "node",
  "containerEnv": {
    "GRADLE_USER_HOME": "/home/node/.gradle",
    "MINELINK_DEVCONTAINER_IMAGE": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm"
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": false,
      "installGradle": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash scripts/dev/bootstrap-prebuild.sh",
  "postAttachCommand": "git status --short --branch && bash scripts/dev/verify-agent-task.sh --scope docs",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "redhat.java",
        "vscjava.vscode-java-pack"
      ]
    },
    "codespaces": {
      "openFiles": [
        "AGENTS.md",
        "ARCHITECTURE.md",
        "docs/agent-workbench.md",
        "docs/minelink-acceptance.md"
      ]
    }
  }
}
