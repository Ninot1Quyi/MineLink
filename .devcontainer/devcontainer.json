{
  "name": "MineLink Agent Worktree",
  "image": "ghcr.io/ninot1quyi/minelink-devcontainer:codex-minelink-mvp-engineering",
  "remoteUser": "node",
  "containerEnv": {
    "GRADLE_USER_HOME": "/home/node/.gradle",
    "MINELINK_DEVCONTAINER_IMAGE": "ghcr.io/ninot1quyi/minelink-devcontainer:codex-minelink-mvp-engineering"
  },
  "postCreateCommand": "bash scripts/dev/bootstrap-prebuild.sh",
  "postAttachCommand": "git status --short --branch && bash scripts/dev/verify-agent-task.sh --scope docs",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "redhat.java",
        "vscjava.vscode-java-pack"
      ]
    },
    "codespaces": {
      "openFiles": [
        "AGENTS.md",
        "ARCHITECTURE.md",
        "docs/agent-workbench.md",
        "docs/minelink-acceptance.md"
      ]
    }
  }
}
